{
    "citas": {
        "estilos": {
            "apa7": {
                "nombre": "Estilo APA",
                "activo": true,
                "plantilla": "{autores} ({anio}). {titulo}. {editorial}. Vol {volumen}({numero}). ISSN: {issn}"
            },
            "yisu": {
                "nombre": "Yisus",
                "activo": true,
                "plantilla": "{autores} Yo Yisus declaro a esta gente, indigente {anio}. WAZAAAAe"
            }
        }
    },
    "paginacion": {
        "limite_catalogo": 50,
        "limite_gestor": 20,
        "max_recomendados": 4,
        "limite_gestor_catalogos": 16
    },
    "recursos": {
        "mostrar_editorial": false,
        "mostrar_volumen": true,
        "mostrar_issn": false
    },
    "buscador": {
        "anio_minimo": 2020
    },
    "archivos": {
        "max_size_mb": 5,
        "extensiones_permitidas": [
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
        ]
    }
}