        icon: 'error',
        title: 'Atención',
        text: '<?= htmlspecialchars($_SESSION['flash_error'], ENT_QUOTES) ?>',
        confirmButtonColor: '#121a3e'
    });
</script>
<?php unset($_SESSION['flash_error']); endif; ?>

<script>
function verDetalles(id, empresa, cupos, linea, area, problema, estadoPrevio = '', skipWarning = false) {
    if (!skipWarning) {
        if (estadoPrevio === 'Aceptado' || estadoPrevio === 'Pendiente') {
            Swal.fire({
                title: 'Postulación Activa',
                text: 'Ya tienes una postulación en proceso o aprobada para esta oferta. No puedes volver a postularte.',
                icon: 'info'
            });
            return;
        }
        
        if (estadoPrevio === 'Rechazado') {
            Swal.fire({
                title: 'Postulación Rechazada',
                text: 'Ya te has postulado a esta oferta, pero has sido rechazado. ¿Quieres volver a postularte y enviar una nueva solicitud?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, volver a postularme',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#10b981'
            }).then((result) => {
                if (result.isConfirmed) {
                    verDetalles(id, empresa, cupos, linea, area, problema, estadoPrevio, true);
                }
            });
            return;
        }
    }
    let tituloLinea = linea && linea.trim() !== '' ? linea : 'General';
    Swal.fire({
        title: `Postularse: ${empresa}`,
        html: `
            <div style="text-align: left; font-size: 0.95rem;">
                <p><strong>Línea de Investigación:</strong> ${tituloLinea}</p>
                <p><strong>Área:</strong> ${area}</p>
                <p><strong>Cupos disponibles:</strong> ${cupos}</p>
                <hr style="margin: 10px 0;">
                <p><strong>Problema a resolver:</strong></p>
                <p style="background: #f8fafc; padding: 10px; border-radius: 5px; border-left: 3px solid #1d4ed8;">${problema}</p>
                
                <hr style="margin: 15px 0;">
                <h4 style="margin-bottom: 5px; color:#1d4ed8; font-weight:bold;">Mensaje de Motivación</h4>
                <textarea id="swal-motivacion" class="swal2-textarea" style="width: 100%; margin: 0; padding: 10px; font-size: 0.9rem;" placeholder="¿Por qué tu equipo es ideal para este proyecto? ¿Qué habilidades tienen?"></textarea>
                
                <h4 style="margin-top: 15px; margin-bottom: 5px; color:#1d4ed8; font-weight:bold;">Integrantes del Equipo (Opcional)</h4>
                <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 10px;">Tú ya estás incluido automáticamente como líder del proyecto. Agrega hasta 2 compañeros adicionales si vas a trabajar en grupo.</p>
                
                <div id="team-members-container"></div>
                <button type="button" id="btn-add-member" style="margin-top: 10px; padding: 6px 12px; background: #e2e8f0; color: #475569; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight:bold;">+ Agregar Compañero</button>
            </div>
        `,
        icon: 'info',
        width: '650px',
        showCancelButton: true,
        confirmButtonColor: '#1d4ed8',
        cancelButtonColor: '#475569',
        confirmButtonText: 'Enviar Postulación',
        cancelButtonText: 'Cancelar',
        didOpen: () => {
            let count = 0;
            const container = document.getElementById('team-members-container');
            const btnAdd = document.getElementById('btn-add-member');
            
            btnAdd.addEventListener('click', () => {
                if (count >= 2) {
                    Swal.showValidationMessage('Solo puedes agregar un máximo de 2 compañeros extra.');
                    return;
                }
                count++;
                const div = document.createElement('div');
                div.style = "display: flex; gap: 5px; margin-bottom: 8px;";
                div.innerHTML = `
                    <input type="text" class="swal2-input team-name" style="margin:0; height:38px; font-size:0.85rem; width: 40%;" placeholder="Nombre completo">
                    <input type="text" class="swal2-input team-cedula" style="margin:0; height:38px; font-size:0.85rem; width: 25%;" placeholder="Cédula">
                    <input type="tel" class="swal2-input team-phone" style="margin:0; height:38px; font-size:0.85rem; width: 25%;" placeholder="Teléfono">
                    <button type="button" style="background: #ef4444; color: white; border: none; border-radius: 4px; width: 10%; cursor: pointer; font-weight:bold;">X</button>
                `;
                // Add event listener to the remove button
                div.querySelector('button').addEventListener('click', function() {
                    div.remove();
                    count--;
                });
                container.appendChild(div);
                Swal.resetValidationMessage(); // clear warning if they clicked too many times before
            });
        },
        preConfirm: () => {
            const motivacion = document.getElementById('swal-motivacion').value.trim();
            if (!motivacion) {
                Swal.showValidationMessage('El mensaje de motivación es obligatorio para que la empresa y el comité conozcan tu perfil.');
                return false;
            }
            
            const members = [];
            const rows = document.getElementById('team-members-container').children;
            for(let i=0; i<rows.length; i++) {
                const name = rows[i].querySelector('.team-name').value.trim();
                const cedula = rows[i].querySelector('.team-cedula').value.trim();
                const phone = rows[i].querySelector('.team-phone').value.trim();
                if (!name || !cedula || !phone) {
                    Swal.showValidationMessage('Por favor completa todos los datos de los compañeros que agregaste, o elimina los campos vacíos con la X.');
                    return false;
                }
                members.push({ nombre: name, cedula: cedula, telefono: phone });
            }
            
            return {
                motivacion: motivacion,
                equipo: members.length > 0 ? JSON.stringify(members) : ''
            };
        }
    }).then((result) => {
        if (result.isConfirmed) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '?ruta=postular-oportunidad';
            
            const inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = 'id_investigacion';
            inputId.value = id;
            form.appendChild(inputId);
            
            const inputMot = document.createElement('input');
            inputMot.type = 'hidden';
            inputMot.name = 'motivacion';
            inputMot.value = result.value.motivacion;
            form.appendChild(inputMot);
            
            if (result.value.equipo) {
                const inputEq = document.createElement('input');
                inputEq.type = 'hidden';
                inputEq.name = 'equipo_extra';
                inputEq.value = result.value.equipo;
                form.appendChild(inputEq);
            }
            
            document.body.appendChild(form);
            form.submit();
        }
    });
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const lineaCheckboxes = document.querySelectorAll('.filter-linea-checkbox');
    const trayectoCheckboxes = document.querySelectorAll('.filter-trayecto-checkbox');
    const cuposCheckboxes = document.querySelectorAll('.filter-cupos-checkbox');
    const articles = Array.from(document.querySelectorAll('.post-card-item'));
    const resetBtn = document.getElementById('btn-limpiar-filtros');
    const searchInput = document.getElementById('search-hero');
    const contador1 = document.getElementById('stats-total-proyectos'); 
    const contador2 = document.getElementById('contador-proyectos-sub');
    const paginationContainer = document.getElementById('pagination-container');

    let filteredArticles = [];
    let currentPage = 1;
    const itemsPerPage = 5; // Show 5 per page like typical results

    function applyFilters() {
        let activeLineas = Array.from(lineaCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
        let activeTrayectos = Array.from(trayectoCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
        let activeCupos = Array.from(cuposCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
        
        let searchText = searchInput ? searchInput.value.toLowerCase() : '';

        // Ocultar todos por defecto
        articles.forEach(article => article.style.display = 'none');

        filteredArticles = articles.filter(article => {
            let itemLinea = article.getAttribute('data-linea');
            let itemTrayecto = article.getAttribute('data-trayecto');
            let itemCupos = article.getAttribute('data-cupos');
            
            let matchesLinea = activeLineas.length === 0 || activeLineas.includes(itemLinea);
            let matchesTrayecto = activeTrayectos.length === 0 || activeTrayectos.includes(itemTrayecto);
            let matchesCupos = activeCupos.length === 0 || activeCupos.includes(itemCupos);
            
            let textContent = article.textContent.toLowerCase();
            let matchesSearch = searchText === '' || textContent.includes(searchText);

            return matchesLinea && matchesTrayecto && matchesCupos && matchesSearch;
        });

        let visibleCount = filteredArticles.length;
        if(contador1) contador1.textContent = visibleCount; 
        if(contador2) contador2.textContent = visibleCount;

        currentPage = 1;
        renderPagination();
    }

    function renderPagination() {
        if (!paginationContainer) return;
        
        const totalPages = Math.ceil(filteredArticles.length / itemsPerPage);
        
        // Hide all items first
        filteredArticles.forEach(a => a.style.display = 'none');

        // Show items for current page
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        
        filteredArticles.slice(startIndex, endIndex).forEach(a => a.style.display = 'flex');

        if (filteredArticles.length === 0) {
            paginationContainer.innerHTML = '<span class="font-meta-code text-[11px] text-slate-500">No hay resultados que coincidan con los filtros.</span>';
            return;
        }

        let html = `<span class="font-meta-code text-[11px] text-slate-500">
            Página ${currentPage} de ${totalPages} &bull; ${filteredArticles.length} resultados
        </span>
        <div class="inline-flex items-center gap-1">
            <button class="px-2.5 py-1 text-slate-500 hover:text-slate-800 rounded text-body-sm disabled:opacity-40" 
                    ${currentPage === 1 ? 'disabled' : ''} onclick="goToPage(${currentPage - 1})">
                Anterior
            </button>`;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
                if (i === currentPage) {
                    html += `<button class="w-8 h-8 flex items-center justify-center rounded bg-[#1e293b] text-white font-meta-code text-meta-code font-bold">${i}</button>`;
                } else {
                    html += `<button class="w-8 h-8 flex items-center justify-center rounded hover:bg-slate-100 text-slate-700 font-meta-code text-meta-code" onclick="goToPage(${i})">${i}</button>`;
                }
            } else if (Math.abs(i - currentPage) === 2) {
                // To avoid multiple ellipses
                if (i > currentPage && i < totalPages) {
                   html += `<span class="w-8 h-8 flex items-center justify-center text-slate-400">...</span>`;
                } else if (i < currentPage && i > 1) {
                   html += `<span class="w-8 h-8 flex items-center justify-center text-slate-400">...</span>`;
                }
            }
        }

        html += `<button class="px-2.5 py-1 text-slate-500 hover:text-slate-800 rounded text-body-sm disabled:opacity-40" 
                    ${currentPage === totalPages ? 'disabled' : ''} onclick="goToPage(${currentPage + 1})">
                Siguiente
            </button>
        </div>`;

        paginationContainer.innerHTML = html;
    }

    window.goToPage = function(page) {
        currentPage = page;
        renderPagination();
        // Scroll to top of results smoothly
        const topOfList = document.getElementById('contador-proyectos-sub');
        if (topOfList) {
            topOfList.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    };

    lineaCheckboxes.forEach(cb => cb.addEventListener('change', applyFilters));
    trayectoCheckboxes.forEach(cb => cb.addEventListener('change', applyFilters));
    cuposCheckboxes.forEach(cb => cb.addEventListener('change', applyFilters));
    if (searchInput) searchInput.addEventListener('input', applyFilters);

    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            lineaCheckboxes.forEach(cb => cb.checked = false);
            trayectoCheckboxes.forEach(cb => cb.checked = false);
            cuposCheckboxes.forEach(cb => cb.checked = false);
            if (searchInput) searchInput.value = '';
            applyFilters();
        });
    }
    
    // Initialize
    applyFilters();
});
</script>