<span class="text-on-primary-container">// 1. Inicializar cliente con credencial universitaria</span>
<span class="text-secondary-fixed">$postulacion</span> = <span class="text-secondary-fixed-dim">new</span> \OpenAlexPST\Postulante([
    <span class="text-green-300">'matricula'</span> =&gt; <span class="text-green-300">'EXP-2023-0194'</span>,
    <span class="text-green-300">'trayecto'</span>  =&gt; 2
]);

<span class="text-on-primary-container">// 2. Enviar postulación de equipo al proyecto</span>
<span class="text-secondary-fixed">$resultado</span> = <span class="text-secondary-fixed">$postulacion</span>-&gt;asociarProyecto([
    <span class="text-green-300">'pst_id'</span>     =&gt; <span class="text-green-300">'pst.prop/2025.t2.0084'</span>,
    <span class="text-green-300">'integrantes'</span>=&gt; [<span class="text-green-300">'V-28.411.092'</span>, <span class="text-green-300">'V-29.014.512'</span>],
    <span class="text-green-300">'comunidad_ok'</span>=&gt; <span class="text-secondary-fixed-dim">true</span>
]);

<span class="text-secondary-fixed-dim">echo</span> <span class="text-secondary-fixed">$resultado</span>-&gt;acta_compromiso_url;
<span class="text-secondary-fixed">?&gt;</span></code></pre>
