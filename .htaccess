# /.htaccess (Raíz del proyecto CIIDI)
RewriteEngine On

# 1. Bloquear acceso a archivos y carpetas sensibles directamente
<FilesMatch "^\.env|\.gitignore|\.git|composer\.(json|lock)|architecture_full\.txt">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Redirigir a public/ EXCEPTO si es un archivo o directorio real (como los CSS en modules/)
RewriteCond %{REQUEST_URI} !/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]