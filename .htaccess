# /.htaccess (Raíz del proyecto CIIDI)
RewriteEngine On

# 1. Bloquear acceso a archivos y carpetas sensibles directamente
<FilesMatch "^\.env|\.gitignore|\.git|composer\.(json|lock)|architecture_full\.txt">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Redirigir la raíz pública si el servidor web apunta a la raíz del repositorio
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
